{
  "name": "mll-lab/laravel-graphql-voyager",
  "description": "Easily integrate GraphQL Voyager into your Laravel project",
  "license": "MIT",
  "keywords": [
    "laravel",
    "graphql",
    "graphql-voyager"
  ],
  "authors": [
    {
      "name": "Benedikt Franke",
      "email": "benedikt@franke.tech"
    }
  ],
  "require": {
    "php": "^7.4 || ^8",
    "illuminate/console": "^8 || ^9 || ^10 || ^11 || ^12 || ^13",
    "illuminate/contracts": "^8 || ^9 || ^10 || ^11 || ^12 || ^13",
    "illuminate/support": "^8 || ^9 || ^10 || ^11 || ^12 || ^13",
    "thecodingmachine/safe": "^1 || ^2 || ^3"
  },
  "require-dev": {
    "ergebnis/composer-normalize": "^2.45",
    "mll-lab/php-cs-fixer-config": "^5.10",
    "nunomaduro/larastan": "^1.0.4 || ^2.9.14 || ^3.1",
    "orchestra/testbench": "^6.47 || ^7.52 || ^8.33 || ^9.11 || ^10 || ^11",
    "phpstan/extension-installer": "^1",
    "thecodingmachine/phpstan-safe-rule": "^1.2"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "autoload": {
    "psr-4": {
      "MLL\\GraphQLVoyager\\": "src/"
    }
  },
  "config": {
    "allow-plugins": {
      "ergebnis/composer-normalize": true,
      "phpstan/extension-installer": true
    },
    "policy": {
      "advisories": {
        "block": false
      }
    },
    "sort-packages": true
  },
  "extra": {
    "laravel": {
      "providers": [
        "MLL\\GraphQLVoyager\\GraphQLVoyagerServiceProvider"
      ]
    }
  }
}
